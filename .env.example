# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Every value here has a working default except
# the API keys, so the benchmark runs with no keys at all in simulation mode.
# ---------------------------------------------------------------------------

# Jev / TypeSafe AI -- get one at https://console.typesafe.ai/
TYPESAFE_API_KEY=

# OpenAI -- used for the Structured Outputs baseline
OPENAI_API_KEY=

# Amazon Bedrock -- only for LLM_PROVIDER=bedrock. There is no key setting:
# authentication goes through the normal AWS chain (AWS_PROFILE, env
# credentials, or an instance role), so configure that however you already do.
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# BOTH simulate flags default to true so `git clone && make bench` works with
# no credentials at all. Understand what that means before quoting anything:
# a fully simulated run compares one set of our assumptions against another.
# Neither side is a measurement. The simulators live in src/clients/ and their
# parameters are ours, not the vendors'.
#
# Set a flag to false (and supply the matching credentials) for real results.
# ---------------------------------------------------------------------------
SIMULATE_JEV=true
SIMULATE_LLM=true

# Models. LLM_PROVIDER=openai reads LLM_MODEL as an OpenAI id; bedrock reads it
# as a Bedrock id, which takes an `anthropic.` prefix -- e.g.
# anthropic.claude-haiku-4-5. Cost is still computed at Anthropic first-party
# rates, which is NOT what Bedrock invoices; see PARTNER_PRICING_CAVEAT.
JEV_MODEL=jev-latest
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Execution. Jev's documented ceiling is 1200 req/min.
CONCURRENCY=16
JEV_RPM_LIMIT=1200
LLM_RPM_LIMIT=450

# Dataset / metrics
N_SCENARIOS=500
SEED=7
ECE_BINS=10
